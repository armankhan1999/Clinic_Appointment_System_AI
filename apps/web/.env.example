# Front Desk dashboard (apps/web). Copy to .env.local; never commit real values.

# Port of the FastAPI process on 127.0.0.1. /api/v1/* is rewritten there (same origin, no CORS).
# Read when `next dev` / `next build` starts: it is baked into the build, so rebuild after changing it.
# The original dev PC uses 8010 because another program holds 8000 (decision D-27).
API_PORT=8000

# End-to-end tests only (npm run test:e2e). Real staff accounts in the DEV database, never production.
E2E_BASE_URL=http://localhost:3000
# How long assertions wait (ms). 5000 by default; up to 15000 when the database is in a distant region.
E2E_EXPECT_TIMEOUT_MS=5000
# Whole-test limit (ms). 30000 by default; a multi-step flow may need 90000 against a distant database.
E2E_TEST_TIMEOUT_MS=30000
E2E_ADMIN_USERNAME=change-me
E2E_ADMIN_PASSWORD=change-me
E2E_RECEPTIONIST_USERNAME=change-me
E2E_RECEPTIONIST_PASSWORD=change-me
