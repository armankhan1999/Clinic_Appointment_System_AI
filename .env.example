# Copy to .env and fill in. Never commit .env. Put comments on their own lines only.

# --- Environment ---
ENV=development

# --- Supabase Postgres: one project, two schemas (D-17) ---
# Project ref: the id in your project URL https://supabase.com/dashboard/project/<ref>
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
# Session pooler host from the dashboard "Connect" dialog (IPv4, port 5432)
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
# Login passwords for the three project roles, generated locally by setup.
# Optional postgres owner password: not read by the app or scripts (D-21).
DB_OWNER_PASSWORD=change-me
# clinic_migrator owns both schemas and runs migrations.
DB_MIGRATOR_PASSWORD=change-me
# clinic_app (dev runtime) and clinic_test_app (tests) have DML rights only
DB_APP_PASSWORD=change-me
DB_TEST_APP_PASSWORD=change-me
DB_SCHEMA=clinic
DB_TEST_SCHEMA=clinic_test
# Supabase CA certificate (Dashboard > Database Settings > SSL Configuration > Download certificate).
# When set, connections use verify-full (CA + hostname). Required when ENV=production.
# DB_SSL_ROOT_CERT=infrastructure/db/prod-ca-2021.crt
# auto (default) always encrypts; disable exists only for the throwaway CI container and is refused
# when ENV=production.
# DB_SSL=auto

# --- Telegram (token from @BotFather) ---
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token

# --- Google Gemini (key from Google AI Studio) ---
# Free tier: synthetic data only (D-16)
GEMINI_API_KEY=replace-with-your-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds one model call may take; past that the model counts as unreachable and the patient gets a
# short fallback message with the clinic phone number within 10 s (E1-S1-AC3). Default 8.
# LLM_TIMEOUT_SECONDS=8
# Seconds a whole reply may take while the model keeps answering (several model calls, tools and
# audit writes); Telegram shows "typing..." meanwhile. Must be >= LLM_TIMEOUT_SECONDS. Default 25.
# AGENT_TURN_BUDGET_SECONDS=25

# --- Staff API (binds to 127.0.0.1 only) ---
# 32+ random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-with-at-least-32-random-characters
# Change if another program already uses port 8000.
API_PORT=8000

# --- Logging (JSON lines on stdout; chat text, names, phones and secrets are never logged) ---
# LOG_LEVEL=INFO

# --- Clinic defaults (seeded into clinic_settings) ---
CLINIC_TIMEZONE=Asia/Kolkata
